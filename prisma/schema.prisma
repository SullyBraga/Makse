generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE_FINAL
  CABELEIREIRA
  PENDENTE
  ADMIN
  VENDEDOR
}

enum OrderStatus {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_SEPARACAO
  ENVIADO
  ENTREGUE
  CANCELADO
}

model DiscountTable {
  id         String   @id @default(cuid())
  name       String
  percentage Float
  users      User[]
  createdAt  DateTime @default(now())
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  passwordHash    String
  role            Role           @default(CLIENTE_FINAL)
  discountTable   DiscountTable? @relation(fields: [discountTableId], references: [id])
  discountTableId String?
  orders          Order[]
  soldOrders      Order[]        @relation("SoldBy")
  addresses       Address[]
  professionalReq ProfessionalRequest?
  createdAt       DateTime       @default(now())
}

model ProfessionalRequest {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String   @unique
  salonName    String
  city         String
  phone        String
  cnpj         String?
  salonAddress String?
  instagram    String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
}

model ProductLine {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  image       String?
  products    Product[]
  order       Int       @default(0)
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  sku            String?          @unique
  description    String           @db.Text
  ingredients    String?          @db.Text
  howToUse       String?          @db.Text
  usage          String?          @db.Text
  productType    String?
  weight         String?
  price          Float
  originalPrice  Float?
  pricePro       Float?
  priceProDesc   Float?
  priceVendedor  Float?
  images         Json             @default("[]")
  line           ProductLine?     @relation(fields: [lineId], references: [id])
  lineId         String?
  proOnly        Boolean          @default(false)
  featured       Boolean          @default(false)
  active         Boolean          @default(true)
  archived       Boolean          @default(false)
  blingId         String?
  relatedProducts Json             @default("[]")
  variants        ProductVariant[]
  orderItems      OrderItem[]
  kitItems        KitItem[]
  coupons         Coupon[]
  createdAt       DateTime         @default(now())

  @@index([active, archived, featured])
}

model ProductVariant {
  id            String      @id @default(cuid())
  product       Product     @relation(fields: [productId], references: [id])
  productId     String
  label         String
  price         Float
  originalPrice Float?
  pricePro      Float?
  priceVendedor Float?
  stock         Int         @default(0)
  orderItems    OrderItem[]
}

model Kit {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  sku              String?    @unique
  description      String?
  images           Json       @default("[]")
  price            Float
  pricePro         Float?
  priceVendedor    Float?
  showInCatalog    Boolean    @default(false)
  showAsSuggestion Boolean    @default(true)
  active           Boolean    @default(true)
  archived         Boolean    @default(false)
  relatedProducts  Json       @default("[]")
  items            KitItem[]
  orderItems       OrderItem[]
  createdAt        DateTime   @default(now())

  @@index([showInCatalog, active, archived])
}

model KitItem {
  id        String  @id @default(cuid())
  kit       Kit     @relation(fields: [kitId], references: [id], onDelete: Cascade)
  kitId     String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  variantId String?
  quantity  Int     @default(1)
}

model Address {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  street     String
  number     String
  complement String?
  city       String
  state      String
  zipCode    String
  country    String   @default("Brasil")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  orders     Order[]
}

model Order {
  id               String      @id @default(cuid())
  user             User        @relation(fields: [userId], references: [id])
  userId           String
  seller           User?       @relation("SoldBy", fields: [sellerId], references: [id])
  sellerId         String?
  status           OrderStatus @default(AGUARDANDO_PAGAMENTO)
  total            Float
  shippingPrice    Float       @default(0)
  shippingMethod   String?
  address          Address?    @relation(fields: [addressId], references: [id])
  addressId        String?
  stripeSessionId  String?
  trackingCode     String?
  paymentMethod    String?
  sellerNote       String?
  customerName     String?
  customerCpf      String?
  customerPhone    String?
  customerAddress  String?
  items            OrderItem[]
  coupon           Coupon?     @relation(fields: [couponId], references: [id])
  couponId         String?
  couponDiscount   Float       @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model OrderItem {
  id        String          @id @default(cuid())
  order     Order           @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product?        @relation(fields: [productId], references: [id])
  productId String?
  kit       Kit?            @relation(fields: [kitId], references: [id])
  kitId     String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  variantId String?
  quantity  Int
  unitPrice Float
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String    // "PERCENTAGE" or "FIXED"
  value          Float
  minOrderValue  Float?
  expiresAt      DateTime?
  usageLimit     Int?
  usageCount     Int       @default(0)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  // Revendedor / Influenciador & Comissão
  partnerName    String?
  commissionRate Float?

  // Restrição de Produto Específico
  product        Product?  @relation(fields: [productId], references: [id])
  productId      String?

  orders         Order[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

